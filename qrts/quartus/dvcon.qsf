## ============================================================================
## dvcon.qsf - Quartus settings for the DE2-115 YOLO26n NPU
##
##     cd qrts/quartus && bash build.sh        (or: quartus_sh --flow compile dvcon)
##
## The board part is marked EP4CE115F29C7N. Quartus rejects that name (Error
## 125095): the N is the RoHS ordering suffix, not a fitting target. Same die,
## same C7 speed grade, identical timing models.
## ============================================================================
set_global_assignment -name TOP_LEVEL_ENTITY dvcon_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"

## SystemVerilog_2005 is the only SystemVerilog value Quartus accepts; there is
## no SYSTEMVERILOG_INPUT_VERSION (it rejects the whole .qsf).
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005

## npu_pkg.svh is `include`d by the NPU sources
set_global_assignment -name SEARCH_PATH ../rtl/npu
set_global_assignment -name SEARCH_PATH ../rtl/platform
set_global_assignment -name SEARCH_PATH ../rtl/eth

## NPU core
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu/npu_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu/npu_dma.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu/npu_array.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu/npu_conv.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu/npu_elem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu/npu_top.sv

## Platform: SDRAM, JTAG control, Ethernet, board display, top level
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mem/sdram_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mem/avalon_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/platform/jtag_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth/crc32_eth.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth/eth_mac_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth/eth_mac_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth/mii_rx_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth/mii_tx_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/eth/eth_cmd_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/platform/dvcon_status.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/platform/dvcon_top.sv

## Timing
set_global_assignment -name SDC_FILE dvcon.sdc

## Pins live in one file only; tools/check_pins.py fails the build if location
## assignments reappear here (the GUI flattens them in when it saves).
source ../pin/de2_115_pins.tcl

## Fitter and analysis
set_global_assignment -name OPTIMIZATION_MODE BALANCED
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name AUTO_DSP_RECOGNITION ON
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name AUTO_ROM_RECOGNITION ON

## Configuration
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name GENERATE_RBF_FILE ON

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top